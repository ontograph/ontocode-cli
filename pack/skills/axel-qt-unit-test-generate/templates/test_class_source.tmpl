// ── Level 1: Specification-Based (数据驱动) ───────────

void Test{CLASS_NAME}::test{METHOD_TITLE}_data()
{{
    // 等价类划分 + 边界值分析
    QTest::addColumn<{{INPUT_TYPE}}>("input");
    QTest::addColumn<{{OUTPUT_TYPE}}>("expected");

    // 有效等价类
    QTest::newRow("normal_case") << {{VALID_INPUT}} << {{EXPECTED_OUTPUT}};

    // 边界值
    QTest::newRow("boundary_min") << {{MIN_INPUT}} << {{MIN_EXPECTED}};
    QTest::newRow("boundary_max") << {{MAX_INPUT}} << {{MAX_EXPECTED}};

    // 无效等价类
    QTest::newRow("invalid_input") << {{INVALID_INPUT}} << {{ERROR_OUTPUT}};
}}

void Test{CLASS_NAME}::test{METHOD_TITLE}()
{{
    QFETCH({{INPUT_TYPE}}, input);
    QFETCH({{OUTPUT_TYPE}}, expected);
    {CLASS_NAME} obj;
    QCOMPARE(obj.{METHOD_NAME}(input), expected);
}}

