{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontocode.local/schemas/excel/named-range-rewrite-mapping.schema.json",
  "title": "Named-range rewrite mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mappings"],
  "properties": {
    "version": {
      "const": 1
    },
    "mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapping"
      }
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workbook_path",
        "sheet_name",
        "formula_targets",
        "expected_name_target",
        "formula_text_to_replace",
        "to_name",
        "scope_expectation",
        "max_replacements_per_formula",
        "all_or_nothing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "workbook_path": {
          "type": "string",
          "minLength": 1
        },
        "sheet_name": {
          "type": "string",
          "minLength": 1
        },
        "formula_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_name_target": {
          "type": "string",
          "minLength": 1
        },
        "formula_text_to_replace": {
          "type": "string",
          "minLength": 1
        },
        "to_name": {
          "type": "string",
          "minLength": 1
        },
        "scope_expectation": {
          "const": "workbook"
        },
        "sheet_name_for_scope": {
          "type": ["string", "null"]
        },
        "max_replacements_per_formula": {
          "type": "integer",
          "minimum": 0
        },
        "reference_mode": {
          "type": "string",
          "enum": ["exact_textual_match_only"],
          "default": "exact_textual_match_only"
        },
        "all_or_nothing": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    }
  }
}
